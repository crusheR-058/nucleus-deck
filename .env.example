# ============================================================
#  NUCLEUS DECK — environment
#  Copy this file to ".env.local" and fill in your keys.
#  cp .env.example .env.local     (macOS/Linux)
#  Copy-Item .env.example .env.local   (Windows PowerShell)
#  Never commit .env.local — it is gitignored.
# ============================================================

# --- AI assistant (free, OpenAI-compatible) ----------------
# Default provider is Groq — free and very fast, no credit card.
# Get a key in seconds at https://console.groq.com/  → API Keys, then paste it here.
AI_API_KEY=

# Optional: switch providers by changing the two lines below.
#   Groq (default):  https://api.groq.com/openai/v1                           | llama-3.3-70b-versatile
#   Google Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/ | gemini-2.0-flash
#   Ollama (local):  http://localhost:11434/v1                                | llama3.1   (AI_API_KEY can stay blank)
#   OpenRouter:      https://openrouter.ai/api/v1                             | a model ending in :free
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# --- YouTube Data API v3 -----------------------------------
# Create a key in Google Cloud Console → APIs & Services → Credentials.
# Enable "YouTube Data API v3". Search costs ~100 quota units (10,000/day free).
YOUTUBE_API_KEY=

# --- News (NewsAPI.org) ------------------------------------
# Powers the News page (photos + sections). Free key at https://newsapi.org/register
# (the free plan works on localhost, which is how this app runs).
# Leave blank to fall back to Google News headlines (no photos).
NEWS_API_KEY=

# --- yt-dlp / ffmpeg (optional overrides) ------------------
# Leave blank to use whatever is on your PATH. Set an absolute path only if
# the binaries are not on PATH (e.g. C:\tools\yt-dlp.exe).
YTDLP_PATH=
FFMPEG_PATH=

# Where downloaded files are written (relative to project root).
DOWNLOAD_DIR=downloads

# --- Cricket (cricketdata.org) -----------------------------
# Powers live cricket scores on the Play page. Free key: sign up at
# https://cricketdata.org → copy your API key → enable the Cricket Score /
# Current Matches API. Leave blank to show a setup hint instead of scores.
CRICKET_API_KEY=

# --- Movies (OMDb) -----------------------------------------
# Optional: enables MOVIE search on the Play page (TV always works without it).
# Free instant key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
